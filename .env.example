# Configuración de entorno local — Flipping Search Intelligence (IP-00 / IP-01)
# NO subir claves reales (.env) al repositorio.

PORT=3001
VITE_API_URL=http://localhost:3001

# Base de datos PostGIS (opcional en modo POC local: si no está activa, el backend usa el motor geoespacial local con las mismas fixtures)
DATABASE_URL=postgresql://flipping:flipping_local_dev@localhost:5432/flipping_search
POSTGRES_USER=flipping
POSTGRES_PASSWORD=flipping_local_dev
POSTGRES_DB=flipping_search
POSTGRES_PORT=5432

# Proveedor de mapas y geocodificación
# Opciones: maplibre_osm (default libre sin API key) | google_maps (requiere clave)
MAP_PROVIDER=maplibre_osm
GOOGLE_MAPS_API_KEY=
USIG_NORMALIZER_ENABLED=true
